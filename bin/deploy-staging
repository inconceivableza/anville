#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

# ✨ Local-only. Deploys main to staging (whatever-you-do-staging) with you pressing Run on GitHub's website, and
# checks each step before the next: main merged, clean and pushed (you push), the Google secrets present, then build,
# deploy and publish-pathway each green for main's commit, and the site serving it with its Google button. Never
# pushes and never reads .env. Needs gh (signed in) and jq. See .claude/sprint-2b-staging-deploy.md.
#
#   bin/deploy-staging              deploy whatever main is
#   bin/deploy-staging sprint-2b    first check that sprint-2b is already merged into main

TOTAL_STAGES=8

ENV_FILE=/dev/null   # nothing here is kept in .env, and .env is never read
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
GH_REPO=inconceivableza/anville
ENVIRONMENT=whatever-you-do-staging
SITE=https://anville.vabl.dev
REDIRECT_URI="$SITE/accounts/google/login/callback/"
MUST_BE_MERGED="${1:-}"
ACTIONS="https://github.com/$GH_REPO/actions/workflows"
ACTIONS_RUNS="https://github.com/$GH_REPO/actions/runs"

g() { git -C "$REPO_DIR" "$@"; }

# copy VALUE puts it on the clipboard where there is one, and always shows it.
copy() {
  if command -v pbcopy >/dev/null 2>&1; then printf '%s' "$1" | pbcopy; note "(copied to the clipboard)"; fi
  printf '    %s%s%s\n' "$BOLD" "$1" "$RESET"
}

# now_less_a_minute: an ISO time a minute ago, in UTC, so a run started just now is never missed.
now_less_a_minute() {
  local t=$(( $(date +%s) - 60 ))
  date -u -r "$t" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$t" +%Y-%m-%dT%H:%M:%SZ
}

# google_secrets_present: both Google secrets are in the environment (names only; values are never readable).
google_secrets_present() {
  local names
  names=$(gh secret list -R "$GH_REPO" --env "$ENVIRONMENT" --json name --jq '.[].name' 2>/dev/null) || return 1
  grep -qx ANVILLE_GOOGLE_CLIENT_ID <<<"$names" && grep -qx ANVILLE_GOOGLE_CLIENT_SECRET <<<"$names"
}

# wait_for_run WORKFLOW SINCE: finds the run of WORKFLOW you started on GitHub (by hand, on main, at main's commit,
# after SINCE) and follows it to the end. Returns failure if it does not go green.
wait_for_run() {
  local workflow="$1" since="$2" id="${3:-}" url
  [[ -n "$id" ]] || printf '  %sWaiting for you to press Run workflow…%s' "$DIM" "$RESET"
  while [[ -z "$id" ]]; do
    sleep 5
    printf '.'
    id=$(gh run list -R "$GH_REPO" --workflow "$workflow" --branch main --event workflow_dispatch --limit 10 \
      --json databaseId,headSha,createdAt \
      --jq "[.[] | select(.headSha == \"$MAIN_SHA\" and .createdAt >= \"$since\")][0].databaseId // empty" \
      2>/dev/null || true)
  done
  url=$(gh run view "$id" -R "$GH_REPO" --json url --jq .url)
  printf '\n'
  say "Found it: $url"
  # ✨ Polled by hand: `gh run watch` on a run only seconds old can exit at once, before its jobs exist, and read
  # as a failure. A failed poll (the network, say) just tries again.
  local status="" conclusion="" state
  printf '  %sFollowing it…%s' "$DIM" "$RESET"
  while [[ "$status" != "completed" ]]; do
    sleep 10
    if state=$(gh run view "$id" -R "$GH_REPO" --json status,conclusion --jq '.status + " " + .conclusion' 2>/dev/null); then
      status=${state%% *}
      conclusion=${state#* }
      printf ' %s' "$status"
    else
      printf ' ?'
    fi
  done
  printf '\n'
  if [[ "$conclusion" == "success" ]]; then
    printf '  %s✓ %s is green%s\n' "$GREEN" "$workflow" "$RESET"
  else
    warn "$workflow did not go green ($conclusion): $url"
    return 1
  fi
}

# run_workflow WORKFLOW: opens its page, waits for your run, and on failure offers to try again or stop.
run_workflow() {
  local workflow="$1" since existing
  # ✨ On a re-run of this wizard, a run of main's commit already going or already green is picked up rather than
  # started again.
  existing=$(gh run list -R "$GH_REPO" --workflow "$workflow" --branch main --event workflow_dispatch --limit 10 \
    --json databaseId,headSha,status,conclusion \
    --jq "[.[] | select(.headSha == \"$MAIN_SHA\" and (.status != \"completed\" or .conclusion == \"success\"))][0].databaseId // empty" \
    2>/dev/null || true)
  if [[ -n "$existing" ]] && confirm "A $workflow run of main's commit is already going or green ($ACTIONS_RUNS/$existing). Use it?"; then
    if wait_for_run "$workflow" "" "$existing"; then return 0; fi
    confirm "Fix it and run $workflow again?" || { warn "Stopped at $workflow. Nothing after it has run."; exit 1; }
  fi
  while true; do
    since=$(now_less_a_minute)
    open_url "$ACTIONS/$workflow"
    if wait_for_run "$workflow" "$since"; then return 0; fi
    confirm "Fix it and run $workflow again?" || { warn "Stopped at $workflow. Nothing after it has run."; exit 1; }
  done
}

for tool in gh jq curl; do
  command -v "$tool" >/dev/null 2>&1 || { printf '%s needs %s.\n' "$0" "$tool" >&2; exit 1; }
done
gh auth status >/dev/null 2>&1 || { printf 'Sign gh in first: gh auth login\n' >&2; exit 1; }

banner "Deploy main to staging ($ENVIRONMENT)"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Main is merged and clean"
while true; do
  problems=()
  [[ "$(g rev-parse --abbrev-ref HEAD)" == main ]] || problems+=("the main checkout is not on main")
  [[ -z "$(g status --porcelain --untracked-files=no)" ]] || problems+=("the main checkout has uncommitted changes (git status)")
  if [[ -n "$MUST_BE_MERGED" ]] && ! g merge-base --is-ancestor "$MUST_BE_MERGED" main; then
    problems+=("$MUST_BE_MERGED is not merged into main yet")
  fi
  (( ${#problems[@]} )) || break
  for p in "${problems[@]}"; do warn "$p"; done
  pause "Put it right, then press Enter to check again"
done
MAIN_SHA=$(g rev-parse main)
printf '  %s✓%s main is %s: %s\n' "$GREEN" "$RESET" "${MAIN_SHA:0:9}" "$(g log -1 --format=%s main)"
if command -v helm >/dev/null 2>&1 && command -v shellcheck >/dev/null 2>&1 && command -v yq >/dev/null 2>&1; then
  say "Checking the charts and scripts (deploy/check.sh)…"
  (cd "$REPO_DIR" && deploy/check.sh) || { warn "deploy/check.sh failed. Fix it before pushing."; exit 1; }
else
  note "helm, shellcheck or yq is missing here, so deploy/check.sh is left to the build workflow, which runs it."
fi
pause "Press Enter to continue"

# ── 2 ─────────────────────────────────────────────────────────────────────
stage "Push main (you)"
remote_sha=$(g ls-remote origin refs/heads/main | cut -f1)
if [[ "$remote_sha" == "$MAIN_SHA" ]]; then
  printf '  %s✓%s GitHub already has main at %s\n' "$GREEN" "$RESET" "${MAIN_SHA:0:9}"
else
  say "GitHub's main is ${remote_sha:0:9}; yours is ${MAIN_SHA:0:9}. Push it yourself, in another terminal:"
  copy "git -C $REPO_DIR push origin main"
  while [[ "$(g ls-remote origin refs/heads/main | cut -f1)" != "$MAIN_SHA" ]]; do
    pause "Press Enter once it has pushed"
  done
  printf '  %s✓%s GitHub has main at %s\n' "$GREEN" "$RESET" "${MAIN_SHA:0:9}"
fi
pause "Press Enter to continue"

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "Google sign-in: the OAuth client"
if google_secrets_present; then
  printf '  %s✓%s The environment already has both Google secrets, so the client exists. Nothing to do.\n' "$GREEN" "$RESET"
elif ! confirm "Set up Google sign-in for staging now? (No leaves staging with email and password only)"; then
  note "Skipped: no Google button on staging."
  SKIPPED+=("Google sign-in (deploy/README.md, \"Set up Google sign-in\")")
else
  say "Sign in to Google Cloud as the church's account, not a personal one."
  open_url "https://console.cloud.google.com/auth/overview"
  step "Project picker → New project, named \"Anville\" (one project for every environment). Select it."
  step "Google Auth Platform → Get started: app name \"Anville\", a church support email, audience External,"
  step "  a church developer contact."
  step "Branding: add vabl.dev under Authorized domains. Leave the logo EMPTY (a logo means days of review)."
  step "Audience: leave it in Testing; under Test users add the Google address of everyone who will try it."
  step "Data access: add openid, …/auth/userinfo.email and …/auth/userinfo.profile, nothing else."
  step "Clients → Create client: Web application, named $ENVIRONMENT, JavaScript origins empty,"
  step "  and this exact Authorized redirect URI (the trailing slash matters):"
  copy "$REDIRECT_URI"
  step "Create it, and keep its page open: the secret is shown in full only now. The next stage stores both."
  GOOGLE_CLIENT=yes
  pause "Press Enter once the client is created"
fi

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "Google sign-in: the environment's secrets"
if google_secrets_present; then
  printf '  %s✓%s ANVILLE_GOOGLE_CLIENT_ID and ANVILLE_GOOGLE_CLIENT_SECRET are in %s\n' "$GREEN" "$RESET" "$ENVIRONMENT"
elif [[ "${GOOGLE_CLIENT:-}" != yes ]]; then
  note "No Google client this run, so no secrets to store."
else
  say "Paste them here and they go straight into the $ENVIRONMENT environment with gh (hidden; kept nowhere else)."
  ask GOOGLE_ID "Client ID (ends .apps.googleusercontent.com):"
  ask_secret GOOGLE_SECRET "Client secret:"
  if confirm "Store both in the $ENVIRONMENT environment on GitHub?"; then
    printf '%s' "$GOOGLE_ID" | gh secret set ANVILLE_GOOGLE_CLIENT_ID -R "$GH_REPO" --env "$ENVIRONMENT"
    printf '%s' "$GOOGLE_SECRET" | gh secret set ANVILLE_GOOGLE_CLIENT_SECRET -R "$GH_REPO" --env "$ENVIRONMENT"
    WRITTEN_SECRET+=(ANVILLE_GOOGLE_CLIENT_ID ANVILLE_GOOGLE_CLIENT_SECRET)
  else
    say "Then add them by hand: Environments → $ENVIRONMENT → Add environment secret, one for each."
    open_url "https://github.com/$GH_REPO/settings/environments"
    pause "Press Enter once both are added"
  fi
  unset GOOGLE_SECRET
  if google_secrets_present; then
    printf '  %s✓%s Both Google secrets are in %s\n' "$GREEN" "$RESET" "$ENVIRONMENT"
  else
    warn "Both are still not there; the deploy will go ahead without a Google button."
    SKIPPED+=("ANVILLE_GOOGLE_CLIENT_ID and ANVILLE_GOOGLE_CLIENT_SECRET in $ENVIRONMENT")
  fi
fi
pause "Press Enter to continue"

# ── 5 ─────────────────────────────────────────────────────────────────────
stage "Build the image"
say "On the page that opens:"
step "Run workflow → Use workflow from: main → Run workflow."
note "It runs the tests and deploy/check.sh, then pushes the image tagged with main's commit."
run_workflow build.yml
pause "Press Enter to continue"

# ── 6 ─────────────────────────────────────────────────────────────────────
stage "Deploy"
warn "This deploy runs sprint 2b's migrations. access 0004 deletes the hackathon's onboarding answers:"
warn "every account on staging meets Before we begin again. It cannot be undone except from the nightly backup."
confirm "Deploy main (${MAIN_SHA:0:9}) to $ENVIRONMENT?" || { warn "Stopped before deploying. Staging is unchanged."; exit 1; }
say "On the page that opens: Run workflow → Use workflow from: main, then"
step "environment: $ENVIRONMENT"
step "tag: main's full commit:"
copy "$MAIN_SHA"
note "It migrates, then checks that $SITE/healthz answers with that commit."
run_workflow deploy.yml
pause "Press Enter to continue"

# ── 7 ─────────────────────────────────────────────────────────────────────
stage "Publish the pathway"
say "A deploy never publishes the pathway, and this one changed it."
say "On the page that opens: Run workflow → Use workflow from: main, then"
step "pathway: whatever-you-do.json"
step "environment: $ENVIRONMENT"
note "People part-way keep the version they started; new sign-ups get this one."
run_workflow publish-pathway.yml
pause "Press Enter to continue"

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "Check the site"
serving=$(curl -fsS --max-time 10 "$SITE/healthz" | jq -r '.commit // empty' 2>/dev/null || true)
if [[ "$serving" == "$MAIN_SHA" ]]; then
  printf '  %s✓%s %s is serving %s\n' "$GREEN" "$RESET" "$SITE" "${MAIN_SHA:0:9}"
else
  warn "$SITE/healthz says '${serving:-nothing}', not ${MAIN_SHA:0:9}"
  SKIPPED+=("$SITE is not serving main's commit")
fi
if curl -fsS --max-time 10 "$SITE/accounts/login/" | grep -q "Continue with Google"; then
  printf '  %s✓%s Sign in offers "Continue with Google"\n' "$GREEN" "$RESET"
elif google_secrets_present; then
  warn "Sign in has no Google button, although both secrets are set: check the pod's log."
  SKIPPED+=("The Google button on $SITE/accounts/login/")
else
  note "No Google button, as expected without its secrets."
fi
say "Now by hand, in a private window:"
open_url "$SITE"
step "The demo notice shows. Sign in with Google as a test user: consent, then Before we begin."
step "Walk one participant: Section 1 and its results, the side cards, Sections 2, 3 and 4 opening in turn."
step "A bad address (/nothing-here) shows Anville's own 404."
note "Staging has EMAIL_URL, so password reset sends real email: try it with an address you can read."
note "Errors are in the pod's log: ssh vabl@anville-staging-01.vabl.dev, then"
note "sudo k3s kubectl -n $ENVIRONMENT logs deployment/anville"
note "A fake participant with observers: … exec deployment/anville -- python manage.py seed_observers --observers 3"
pause "Press Enter when you're done"

finish
