#!/usr/bin/env bash
# ✨ Local-only. Follows .claude/tool-log.txt during an /implement-spec build, showing only what is worth watching:
# subagents starting and handing back, commits, merges, worktrees and branches, test runs, migrations, ticket and
# manual-check edits, and anything risky. Reads, searches and plain looking-around commands are left out.
#
#   bin/build-watch          the last 200 lines' worth, then follow
#   bin/build-watch B2B      only lines mentioning B2B (a worktree, a ticket, "commit")
#   bin/build-watch --once   today's whole log, filtered, without following (add a word to narrow it)
#
# Colours: red for anything risky (push, .env, force, hard reset, branch -D, rm -rf, edits outside the project),
# bold magenta for commits and merges, cyan for subagents starting and handing back, yellow for test runs and
# migrations; the command or path after ┊ dimmed.

log="$(cd "$(dirname "$0")/.." && pwd)/.claude/tool-log.txt"
if [ "${1:-}" = "--once" ]; then
  shift
  read_log() { cat "$log"; }
else
  read_log() { tail -n 200 -F "$log" 2>/dev/null; }
fi
read_log \
  | grep --line-buffered -i -- "${1:-}" \
  | awk '
      BEGIN { for (i = 128; i < 256; i++) hi = hi sprintf("%c", i) }
      function paint(colour) { line = "\033[" colour "m" line "\033[0m" }
      # The log keeps long Bash commands whole; show about 140 characters after ┊. This awk counts bytes, so drop
      # any trailing non-ASCII bytes rather than print half a character.
      function trim(s,   at, cut) {
        at = index(s, "┊")
        if (!at || length(s) <= at + 143) return s
        cut = substr(s, 1, at + 142)
        while (index(hi, substr(cut, length(cut), 1))) cut = substr(cut, 1, length(cut) - 1)
        return cut "…"
      }
      {
        tool = $3
        line = trim($0)
        # Everything before ┊: time, agent, tool and description. Logs before 20 Oct cut long commands short, so a
        # commit behind a long git add can lose its "commit"; the description still says so.
        head = $0; sub(/┊.*/, "", head)
        said_commit = (head ~ /  (Commit|Merge) |[ ,]and (commit|merge) |, (commit|merge) /)
        risky = ($0 ~ /git push|\.env([^.a-z]|$)|--force|reset --hard|branch -D|rm -rf|clean -f|DROP |flush/)
        keep = 0
        if (tool == "Agent" || tool == "SubagentHandback" || tool == "SendMessage" || tool == "Skill") keep = 1
        else if (tool == "Bash") {
          # Match the command after ┊, not the description, and leave out git calls that only look.
          cmd = $0; sub(/^[^┊]*┊/, "", cmd)
          if (cmd ~ /git .*( add |commit|merge|worktree (add|remove|prune)|branch (-d|-D|-m|[a-z0-9])|rebase|checkout|switch|stash|reset|cherry-pick|tag )/) keep = 1
          if (cmd ~ /git .*(--merged|--list|merge-base|log |diff |check-ignore)/ && cmd !~ /git .*(commit|merge( |$)|-[dD] |remove)/) keep = 0
          # Only the git rule can be undone by a looking git call; a test run or new worktree beside one still counts.
          if (said_commit || cmd ~ /pytest|makemigrations|migrate|createcachetable|npm ([^;&|]* )?(ci|install|run)( |$)|bin\/worktree [a-z]|(^|[ ;&|(])rm /) keep = 1
        }
        else if (tool == "Edit" || tool == "Write" || tool == "NotebookEdit") {
          if ($0 ~ /manual-checks|\.scratch\/|migrations\/|docs\/adr|CONTEXT\.md|settings\.json|bin\//) keep = 1
          # A path still absolute after the hook shortened it is outside the project, its worktrees and the scratchpad.
          if ($0 ~ /  (Edit|Write) +\// && $0 !~ /\.claude\/projects\/.*\/memory\//) { keep = 1; risky = 1 }
        }
        if (risky) keep = 1
        if (!keep) next

        sub(/┊.*/, "\033[2m&\033[0m", line)
        if (risky) paint("1;31")
        else if (said_commit || $0 ~ /git[^┊]*(commit|merge)/) paint("1;35")
        else if (tool == "Agent" || tool == "SubagentHandback") paint("36")
        else if ($0 ~ /pytest|makemigrations|migrate/) paint("33")
        print line
        fflush()
      }'
