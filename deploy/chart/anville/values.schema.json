{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tier", "image", "secretName", "postgres", "backup"],
  "properties": {
    "tier": { "enum": ["staging", "production"] },
    "host": { "type": "string" },
    "hostname": { "type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
    "issuer": { "enum": ["letsencrypt-staging", "letsencrypt-prod"] },
    "ingressClassName": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "secretName": { "type": "string", "minLength": 1 },
    "secretChecksum": { "type": "string" },
    "web": {
      "type": "object",
      "properties": {
        "workers": { "type": "integer", "minimum": 1 },
        "hstsSeconds": { "type": "integer", "minimum": 0 },
        "connMaxAge": { "type": "integer", "minimum": 0 }
      }
    },
    "resources": { "type": "object" },
    "demo": {
      "type": "object",
      "properties": { "notice": { "type": "string" } }
    },
    "enrolment": {
      "type": "object",
      "properties": { "required": { "type": "boolean" } }
    },
    "email": {
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "disclaimer": { "type": "string" }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "storage": { "type": "string" },
        "resources": { "type": "object" }
      }
    },
    "backup": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string" },
        "keep": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
