{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anville.invalid/schemas/pathway.schema.json",
  "title": "Pathway document",
  "$comment": "✨ Drafted with AI assistance.",
  "description": "One pathway's content, instrument, measurement and presentation. Data only: nothing in it is executable (ADR 0003).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "title", "content"],
  "properties": {
    "format": { "const": 1 },
    "title": { "$ref": "#/$defs/text" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buckets": {
          "description": "Ordered from weakest to strongest.",
          "type": "array",
          "items": { "$ref": "#/$defs/bucket" }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frameworks": { "type": "array", "items": { "$ref": "#/$defs/framework" } },
        "scoring": {
          "description": "How a sort is scored: a named method, frozen once any response is scored with it (ADR 0003).",
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": { "method": { "enum": ["compositional_share"] } }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constructs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["construct", "description"],
            "properties": {
              "construct": { "$ref": "#/$defs/identifier" },
              "description": { "$ref": "#/$defs/text" },
              "persona": {
                "description": "A short name for the construct shown beside it, such as 'The Philosopher'.",
                "$ref": "#/$defs/text"
              },
              "tone": {
                "description": "The colour of the construct's bar and item scores, from the stylesheet's named tones.",
                "enum": ["violet", "rose", "green", "moss", "blue", "brown"]
              }
            }
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["framework", "heading"],
            "properties": {
              "framework": { "$ref": "#/$defs/identifier" },
              "heading": { "$ref": "#/$defs/text" },
              "subtitle": { "$ref": "#/$defs/text" },
              "bars": {
                "description": "How the framework's bars are coloured: by each construct's tone, or by rank so tied scores share a colour.",
                "enum": ["tone", "rank"],
                "default": "tone"
              }
            }
          }
        },
        "results_title": {
          "description": "The results page's title. {name} is replaced with the participant's name.",
          "$ref": "#/$defs/text"
        },
        "disclaimer": { "$ref": "#/$defs/text" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "description": "A stable name, never a position. Starts with a letter.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 64
    },
    "text": {
      "description": "One string for every role, or wording per role. A blank observer wording means the same as the participant's.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["participant"],
          "properties": {
            "participant": { "type": "string" },
            "observer": { "type": "string" }
          }
        }
      ]
    },
    "estimate": {
      "description": "How long this takes, worded as it is shown, such as 'About 15 minutes'. On a section it shows on the hub and at the top of the section; on a block, just above the block, for a section with several activities.",
      "$ref": "#/$defs/text"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/text" },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "estimate": { "$ref": "#/$defs/estimate" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "gate": { "$ref": "#/$defs/gate" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "type": { "enum": ["rich_text", "scripture_reading", "long_text", "agreement_scale", "single_select", "sort_assessment", "section_link"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "rich_text" } } }, "then": { "$ref": "#/$defs/rich_text" } },
        { "if": { "properties": { "type": { "const": "scripture_reading" } } }, "then": { "$ref": "#/$defs/scripture_reading" } },
        { "if": { "properties": { "type": { "const": "long_text" } } }, "then": { "$ref": "#/$defs/long_text" } },
        { "if": { "properties": { "type": { "const": "agreement_scale" } } }, "then": { "$ref": "#/$defs/agreement_scale" } },
        { "if": { "properties": { "type": { "const": "single_select" } } }, "then": { "$ref": "#/$defs/single_select" } },
        { "if": { "properties": { "type": { "const": "sort_assessment" } } }, "then": { "$ref": "#/$defs/sort_assessment" } },
        { "if": { "properties": { "type": { "const": "section_link" } } }, "then": { "$ref": "#/$defs/section_link" } }
      ]
    },
    "rich_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "rich_text" },
        "estimate": { "$ref": "#/$defs/estimate" },
        "variant": {
          "description": "How the text is set off: plain prose, or a hint box (such as 'The big question').",
          "enum": ["plain", "hint"],
          "default": "plain"
        },
        "label": {
          "description": "An optional short lead-in shown above the body, such as 'The big question'.",
          "$ref": "#/$defs/text"
        },
        "body": {
          "description": "Plain text. A blank line starts a new paragraph.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "scripture_reading": {
      "description": "Passages to read, and a confirmation that opens the activity beneath them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "passages"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "scripture_reading" },
        "estimate": { "$ref": "#/$defs/estimate" },
        "heading": { "$ref": "#/$defs/text" },
        "passages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference", "text"],
            "properties": {
              "reference": {
                "description": "Where the passage is from, such as '1 Corinthians 12:4-11'.",
                "$ref": "#/$defs/text"
              },
              "text": {
                "description": "The passage itself. Plain text; a blank line starts a new paragraph.",
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "note": {
          "description": "What to notice while reading, set beneath the passages.",
          "$ref": "#/$defs/text"
        },
        "confirm_label": {
          "description": "The wording of the confirm control. Defaults to \"I have read these\".",
          "$ref": "#/$defs/text"
        }
      }
    },
    "agreement_scale": {
      "description": "A prompt the participant rates from 1 to 10, with a label at each end of the scale.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "min_label", "max_label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "agreement_scale" },
        "estimate": { "$ref": "#/$defs/estimate" },
        "prompt": { "$ref": "#/$defs/text" },
        "min_label": { "$ref": "#/$defs/text" },
        "max_label": { "$ref": "#/$defs/text" },
        "fixed_once_complete": {
          "description": "Once the rating has been answered and this section completed, it can no longer be changed, even if the section is reopened. For a baseline measured again later.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "single_select": {
      "description": "One choice from a list, such as the reason for taking the course. The answer is the chosen option's identifier.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "single_select" },
        "estimate": { "$ref": "#/$defs/estimate" },
        "prompt": { "$ref": "#/$defs/text" },
        "placeholder": {
          "description": "What the list shows before anything is chosen, such as 'Select...'. It is never an answer.",
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {
                "description": "What is stored when this option is chosen. Keep it when rewording the label.",
                "$ref": "#/$defs/identifier"
              },
              "label": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "sort_assessment": {
      "description": "The instrument's sort: every item placed in a bucket and fine-tuned, then scored once as a result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "sort_assessment" },
        "estimate": { "$ref": "#/$defs/estimate" }
      }
    },
    "section_link": {
      "description": "A way to another section, shown with that section's title and the participant's status there.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "section"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "section_link" },
        "estimate": { "$ref": "#/$defs/estimate" },
        "section": { "$ref": "#/$defs/identifier" },
        "body": {
          "description": "Plain text saying what is there. A blank line starts a new paragraph.",
          "$ref": "#/$defs/text"
        },
        "button_label": {
          "description": "The wording of a button that leads there, such as 'Open Strengths Assessment →'. Without one, the section's title is the link.",
          "$ref": "#/$defs/text"
        },
        "holds_what_follows": {
          "description": "Hold the rest of this section shut until the linked section's gate passes, as a scripture reading does until it is confirmed.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "long_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "long_text" },
        "estimate": { "$ref": "#/$defs/estimate" },
        "prompt": { "$ref": "#/$defs/text" },
        "placeholder": {
          "description": "Ghost text in the empty box, such as 'Dear me,'. A hint only: it is never saved as the answer.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "gate": {
      "description": "What must be true before the participant may complete this section. Every clause must pass.",
      "type": "object",
      "additionalProperties": false,
      "required": ["clauses"],
      "properties": {
        "clauses": { "type": "array", "items": { "$ref": "#/$defs/clause" } }
      }
    },
    "clause": {
      "description": "One requirement, chosen from a fixed set and configured. Never an expression (ADR 0003).",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["has_answer", "min_text_length", "entry_count", "distinct_value_count", "every_entry_has"]
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "has_answer" } } }, "then": { "$ref": "#/$defs/has_answer" } },
        { "if": { "properties": { "type": { "const": "min_text_length" } } }, "then": { "$ref": "#/$defs/min_text_length" } },
        { "if": { "properties": { "type": { "const": "entry_count" } } }, "then": { "$ref": "#/$defs/entry_count" } },
        { "if": { "properties": { "type": { "const": "distinct_value_count" } } }, "then": { "$ref": "#/$defs/distinct_value_count" } },
        { "if": { "properties": { "type": { "const": "every_entry_has" } } }, "then": { "$ref": "#/$defs/every_entry_has" } }
      ]
    },
    "clause_message": {
      "description": "Shown to the participant when this clause, and no other, is what is still missing.",
      "$ref": "#/$defs/text"
    },
    "has_answer": {
      "description": "The block has been answered. Blank text and an empty list do not count as an answer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "block", "message"],
      "properties": {
        "type": { "const": "has_answer" },
        "block": { "$ref": "#/$defs/identifier" },
        "message": { "$ref": "#/$defs/clause_message" }
      }
    },
    "min_text_length": {
      "description": "The block's text answer is at least this long, not counting space at either end.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "block", "min", "message"],
      "properties": {
        "type": { "const": "min_text_length" },
        "block": { "$ref": "#/$defs/identifier" },
        "min": { "type": "integer", "minimum": 1 },
        "message": { "$ref": "#/$defs/clause_message" }
      }
    },
    "entry_count": {
      "description": "The block holds at least this many entries.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "block", "min", "message"],
      "properties": {
        "type": { "const": "entry_count" },
        "block": { "$ref": "#/$defs/identifier" },
        "min": { "type": "integer", "minimum": 1 },
        "only_with_content": {
          "description": "Count only entries with something in them, so blank rows a widget seeded do not count.",
          "type": "boolean",
          "default": false
        },
        "message": { "$ref": "#/$defs/clause_message" }
      }
    },
    "distinct_value_count": {
      "description": "The block's entries hold at least this many different values for one field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "block", "field", "min", "message"],
      "properties": {
        "type": { "const": "distinct_value_count" },
        "block": { "$ref": "#/$defs/identifier" },
        "field": { "$ref": "#/$defs/identifier" },
        "min": { "type": "integer", "minimum": 1 },
        "message": { "$ref": "#/$defs/clause_message" }
      }
    },
    "every_entry_has": {
      "description": "Every entry holds a value for this field. True of no entries at all, so pair it with entry_count.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "block", "field", "message"],
      "properties": {
        "type": { "const": "every_entry_has" },
        "block": { "$ref": "#/$defs/identifier" },
        "field": { "$ref": "#/$defs/identifier" },
        "message": { "$ref": "#/$defs/clause_message" }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "seed"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/text" },
        "seed": {
          "description": "Where this bucket's sliders start, and so the answer an untouched slider gives: a whole number, as every answer value is.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "loads"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "text": { "$ref": "#/$defs/text" },
        "loads": {
          "description": "The constructs this item loads onto: exactly one in each framework.",
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "constructs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/text" },
        "constructs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    }
  }
}
